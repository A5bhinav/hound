ANTHROPIC_API_KEY=
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
CHAINABUSE_API_KEY=
CARTESIA_API_KEY=
HOUND_API_URL=http://localhost:8000
# API ops. HOUND_ADMIN_TOKEN gates POST /demo/reset (header X-Hound-Admin); unset = localhost only.
HOUND_ADMIN_TOKEN=
# Extra CORS origin(s) beyond localhost, comma separated, e.g. the public web URL.
HOUND_PUBLIC_ORIGIN=
# chain adapters (Jinka). All optional: leave them commented out (an empty value is not "unset"
# for every loader), uncomment only to override. Defaults work with no keys.
BLOCKSCOUT_API_KEY=
# ETH_ARCHIVE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>  (archive RPC for past-block balances)
# ETH_RPC_URLS=https://rpc1,https://rpc2
# ETH_LOGS_RPC_URLS=
# HOUND_ETH_TRANSFER_SOURCES=etherscan_logs,rpc,blockscout_v2,blockscout
# HOUND_MAX_TRANSFERS=5000
# HOUND_CACHE_DIR=
# HOUND_OFFLINE=1
# HOUND_TRACE_DIRS=examples,data/traces
# HOUND_CACHE_MODE=prefer_cache
# HOUND_SNAPSHOT=0
# voice intake (Cartesia agent: scripts/cartesia_agent.py). The token is shared with the agent's tool header.
HOUND_INTAKE_TOKEN=
# PUBLIC_BASE_URL=https://<web tunnel host>
# HOUND_PUBLIC_TOOL_URL=https://<backend tunnel host>/intake/voice/story
